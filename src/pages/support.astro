---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Categories. Each one leads to the same place: here.
const categories = [
  { name: 'Notifications', count: '41 articles', note: 'None of which turn them off.' },
  { name: 'Updates', count: '18 articles', note: 'Rewritten after every update.' },
  { name: 'Smart Devices', count: '63 articles', note: 'They are not.' },
  { name: 'Streaming', count: '9 articles', note: 'Longer than most of the shows.' },
  { name: 'Accounts & Passwords', count: '27 articles', note: 'You will read four of them.' },
  { name: 'The Algorithm', count: '1 article', note: 'It is not helpful either.' },
];

// The Help Center. Every answer is technically correct and completely useless.
const articles = [
  {
    q: 'The app updated and I can’t find anything.',
    a: 'Correct. The update moved everything in order to improve your experience. What you want is now three taps deeper, inside a menu called More, beneath a heading called Other. It will move again in the spring, and we will call that an improvement too.',
    cat: 'Updates',
  },
  {
    q: 'How do I turn off notifications?',
    a: 'Open Settings, then Notifications, then the app, then Advanced, then Categories, then switch off all eleven categories individually. You will miss one. It will be the loud one, and it will find you at 6:04 a.m.',
    cat: 'Notifications',
  },
  {
    q: 'I accepted the cookies. Why is it still asking?',
    a: 'You accepted those cookies. This is a different banner, from a different vendor, asking about legitimate interest — which is a legal term meaning theirs, not yours. There are eleven hundred vendors. Reject All is at the bottom, in grey, and it is a different size on purpose.',
    cat: 'The Algorithm',
  },
  {
    q: 'My smart bulb won’t connect.',
    a: 'The bulb is on the 2.4GHz network. Your phone is on the 5GHz network. The hub is on neither and has been quietly offline since a firmware update it applied without asking. The bulb, meanwhile, works perfectly as a bulb. There is a switch on the wall. There always was.',
    cat: 'Smart Devices',
  },
  {
    q: 'The AI gave me a wrong answer.',
    a: 'It gave you a confident answer. You supplied the assumption that those were the same thing. In fairness, so did we, and we built it.',
    cat: 'The Algorithm',
  },
  {
    q: 'I can’t find anything to watch.',
    a: 'You have four subscriptions and you have been scrolling for forty minutes. This is not a fault. This is the product working exactly as designed, and you are, right now, the engagement metric someone will be very pleased about on Monday.',
    cat: 'Streaming',
  },
  {
    q: 'My password was rejected.',
    a: 'Passwords must contain a capital letter, a number, a symbol, and nothing you could ever plausibly remember. Yours failed the last requirement. Also, it cannot be one of your previous twenty-four passwords, which we do not store, except for the purposes of checking that.',
    cat: 'Accounts & Passwords',
  },
  {
    q: 'It says you’ve updated your privacy policy.',
    a: 'We have. You will now click Agree, because the alternative is reading it, and we have both been here before. The changes are on page nine. They are not in your favor.',
    cat: 'Accounts & Passwords',
  },
  {
    q: 'Everything is running slowly.',
    a: 'You have forty-seven tabs open. Nine are playing audio. One of them is the one you are looking for, and closing the other forty-six is the only known method of finding it.',
    cat: 'Updates',
  },
  {
    q: 'The update said “performance improvements and bug fixes.”',
    a: 'It did. We diffed it. A button moved four pixels to the left and the icon is now slightly rounder. Performance is unchanged. The bug you reported is fine, thank you for asking, and celebrated its second birthday last week.',
    cat: 'Updates',
  },
  {
    q: 'How do I cancel?',
    a: 'We have a chat widget for that. It opens with one question, and none of the available answers is "cancel." Selecting "Something else" returns you to the first question. Some users report success by leaving the country.',
    cat: 'Accounts & Passwords',
  },
  {
    q: 'Why does my TV make me sign in every single week?',
    a: 'Security. Your password is the one from 2019 with a number after it, and you know which number, and it is still not the right one. The on-screen keyboard is arranged alphabetically to make this take longer.',
    cat: 'Streaming',
  },
];
---

<Layout
  title="Help Center — Snark™ | Have You Tried Turning It Off and On Again"
  description="Twelve articles that answer your question precisely and help you not at all. Average resolution time: eventually."
>
  <Header />
  <main class="px-4 py-14 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center">
        <p class="mb-2 font-mono text-xs uppercase tracking-widest text-lime">Help Center</p>
        <h1 class="text-balance text-4xl font-black tracking-tight text-white sm:text-5xl">
          Have You Tried Turning It Off and On Again
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-balance text-base text-monogrey sm:text-lg">
          Every answer below is completely accurate and will not help you in the
          slightest. That is not a bug. We checked.
        </p>
      </div>

      <!-- Search that finds nothing, beautifully -->
      <form id="help-search" class="mx-auto max-w-xl" novalidate>
        <label class="sr-only" for="help-query">Search the help center</label>
        <div class="flex gap-2">
          <input
            id="help-query"
            type="search"
            placeholder="Describe your problem in your own words"
            class="min-h-12 w-full rounded-xl border border-stroke bg-obsidian px-4 text-base text-zinc-200 placeholder:text-zinc-600 transition-colors duration-200 focus:border-lime focus:outline-none focus:ring-1 focus:ring-lime"
          />
          <button
            type="submit"
            class="flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-lime px-5 text-sm font-bold text-obsidian transition-all duration-200 hover:bg-lime-glow active:scale-95"
          >
            Search
          </button>
        </div>
        <p id="help-search-note" class="mt-3 min-h-5 text-center font-mono text-xs text-zinc-500">
          Searching returns 0 results. We have made peace with this.
        </p>
      </form>

      <!-- Categories -->
      <div class="mt-14 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          categories.map((category) => (
            <a
              href="#articles"
              class="spotlight flex min-h-12 flex-col rounded-2xl border border-stroke bg-surface p-5 transition-all duration-300 hover:-translate-y-1 hover:border-lime"
            >
              <p class="text-base font-bold text-white">{category.name}</p>
              <p class="mt-1 font-mono text-[11px] uppercase tracking-wider text-lime">
                {category.count}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-monogrey">{category.note}</p>
            </a>
          ))
        }
      </div>

      <!-- Articles -->
      <div id="articles" class="mt-14 scroll-mt-24 sm:mt-20">
        <h2 class="mb-2 text-2xl font-black text-white sm:text-3xl">
          Articles People Read Twice, Hoping
        </h2>
        <p class="mb-8 text-sm text-monogrey sm:text-base">
          Sorted by how often they fail to resolve the issue. Descending.
        </p>

        <div class="space-y-3">
          {
            articles.map((article) => (
              <details class="group rounded-xl border border-stroke bg-surface transition-colors duration-200 hover:border-lime">
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-base font-semibold text-zinc-200 [&::-webkit-details-marker]:hidden">
                  <span class="flex-1">{article.q}</span>
                  <span class="hidden shrink-0 rounded-full border border-stroke bg-obsidian px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-zinc-500 sm:inline">
                    {article.cat}
                  </span>
                  <svg
                    class="h-5 w-5 shrink-0 text-lime transition-transform duration-200 group-open:rotate-45"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-sm leading-relaxed text-monogrey">{article.a}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-stroke pt-4">
                    <span class="mr-1 font-mono text-[11px] uppercase tracking-wider text-zinc-500">
                      Was this helpful?
                    </span>
                    <button
                      type="button"
                      class="helpful-btn flex min-h-12 items-center justify-center rounded-xl border border-stroke bg-obsidian px-5 text-sm font-semibold text-zinc-300 transition-colors duration-200 hover:border-lime hover:text-lime"
                    >
                      Yes
                    </button>
                    <button
                      type="button"
                      class="helpful-btn flex min-h-12 items-center justify-center rounded-xl border border-stroke bg-obsidian px-5 text-sm font-semibold text-zinc-300 transition-colors duration-200 hover:border-snarkpink hover:text-snarkpink"
                    >
                      No
                    </button>
                    <span class="helpful-note font-mono text-[11px] text-snarkpink" />
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Escalation, so called -->
      <div class="mt-14 rounded-2xl border border-lime/40 bg-lime/5 p-6 text-center sm:mt-20 sm:p-8">
        <p class="font-mono text-xs uppercase tracking-widest text-lime">Still Stuck</p>
        <h2 class="mt-3 text-2xl font-black text-white sm:text-3xl">
          Then You’ll Want a Human
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-monogrey sm:text-base">
          Our support team is available around the clock, in the sense that the clock
          continues regardless. Typical first response: within one business era.
        </p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={`${base}#contact`}
            class="flex min-h-12 w-full items-center justify-center rounded-xl bg-lime px-6 py-3 text-base font-bold text-obsidian transition-all duration-200 hover:bg-lime-glow hover:shadow-lime-glow active:scale-95 sm:w-auto"
          >
            Open a Ticket
          </a>
          <button
            id="live-chat"
            type="button"
            class="flex min-h-12 w-full items-center justify-center rounded-xl border border-stroke bg-obsidian px-6 py-3 text-base font-semibold text-zinc-200 transition-all duration-200 hover:border-lime hover:text-lime active:scale-95 sm:w-auto"
          >
            Start Live Chat
          </button>
        </div>
        <p id="live-chat-status" class="mt-4 min-h-5 font-mono text-xs text-snarkpink"></p>
      </div>

      <p class="mt-8 text-center font-mono text-[11px] text-zinc-500">
        Average resolution time: eventually. Customer satisfaction: 2.0 out of 5, our
        highest ever.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Search. It works. It just doesn't find anything.
  const searchForm = document.getElementById('help-search') as HTMLFormElement | null;
  const searchInput = document.getElementById('help-query') as HTMLInputElement | null;
  const searchNote = document.getElementById('help-search-note');

  const NO_RESULTS = [
    '0 results. Have you tried spelling it the way we spell it?',
    '0 results. Did you mean: something else entirely?',
    '0 results. The article exists. It is simply not indexed, and never has been.',
    '0 results. Showing results for a word you did not type.',
    '0 results. Try fewer words. Then try none. Then try accepting it.',
  ];

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!searchNote) return;
    searchNote.textContent = searchInput?.value
      ? NO_RESULTS[Math.floor(Math.random() * NO_RESULTS.length)]
      : 'You searched for nothing. Finally, a query we can fully satisfy.';
    searchNote.classList.remove('text-zinc-500');
    searchNote.classList.add('text-snarkpink');
  });

  // "Was this helpful?" — both buttons agree with each other.
  const FEEDBACK = [
    'Thank you. This has been recorded and will not be acted upon.',
    'Noted. Your feedback joins 40,000 others in a folder nobody owns.',
    'Logged. The article will be updated never.',
    'Received. We are sorry to hear that, in the sense that we have heard it.',
  ];

  document.querySelectorAll<HTMLButtonElement>('.helpful-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.parentElement;
      const note = row?.querySelector<HTMLElement>('.helpful-note');
      if (note) note.textContent = FEEDBACK[Math.floor(Math.random() * FEEDBACK.length)];
      row?.querySelectorAll<HTMLButtonElement>('.helpful-btn').forEach((other) => {
        other.disabled = true;
        other.classList.add('opacity-40', 'cursor-default');
      });
    });
  });

  // Live chat, faithfully reproduced.
  const chatBtn = document.getElementById('live-chat') as HTMLButtonElement | null;
  const chatStatus = document.getElementById('live-chat-status');

  const CHAT_STAGES = [
    'Connecting you to an agent…',
    'You are number 34 in the queue.',
    'You are number 36 in the queue.',
    'An agent is typing…',
    'The agent has sent you a link to this page.',
  ];

  chatBtn?.addEventListener('click', () => {
    if (chatBtn.disabled) return;
    chatBtn.disabled = true;
    chatBtn.classList.add('opacity-50', 'cursor-default');
    let i = 0;
    if (chatStatus) chatStatus.textContent = CHAT_STAGES[i];
    const timer = window.setInterval(() => {
      i += 1;
      if (i >= CHAT_STAGES.length) {
        window.clearInterval(timer);
        chatBtn.disabled = false;
        chatBtn.classList.remove('opacity-50', 'cursor-default');
        chatBtn.textContent = 'Try Live Chat Again';
        return;
      }
      if (chatStatus) chatStatus.textContent = CHAT_STAGES[i];
    }, 1400);
  });
</script>
