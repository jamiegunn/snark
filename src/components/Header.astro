---
import Logo from './Logo.astro';

// BASE_URL is '/' on the custom domain, but would arrive as '/snark' (no
// trailing slash) under a project-pages path. Normalize either way so
// `${base}pricing` becomes '/pricing' or '/snark/pricing' — never '/snarkpricing'.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// 'Generator' lived here until the Deploy Snark button made it redundant.
const navLinks = [
  { href: `${base}pricing`, label: 'Pricing' },
  { href: `${base}docs`, label: 'Docs' },
  { href: `${base}support`, label: 'Help' },
  { href: `${base}status`, label: 'Status' },
  { href: `${base}#contact`, label: 'Complain' },
];
---

<header
  class="sticky top-0 z-50 border-b border-stroke bg-obsidian/90 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <!-- Brand -->
    <a href={base} class="flex min-h-12 items-center gap-3">
      <Logo class="h-9 w-9 sm:h-10 sm:w-10" />
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-extrabold tracking-tight text-white sm:text-xl">
          Snark<span class="text-lime">™</span>
        </span>
        <span class="hidden font-mono text-[10px] text-monogrey sm:block">
          sarcasm-as-a-service
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="flex min-h-12 items-center rounded-lg px-3 text-sm font-medium text-monogrey transition-colors duration-200 hover:bg-surface hover:text-lime"
          >
            {link.label}
          </a>
        ))
      }
      <button
        type="button"
        class="sincerity-mode ml-1 flex min-h-12 items-center gap-1.5 rounded-lg border border-stroke px-3 text-sm font-medium text-monogrey transition-colors duration-200 hover:border-snarkpink hover:text-snarkpink"
      >
        <span aria-hidden="true">🌷</span>
        Sincerity Mode™
      </button>
      <a
        href={`${base}#generator`}
        class="ml-2 flex min-h-12 items-center rounded-xl bg-lime px-5 text-sm font-bold text-obsidian shadow-lime-glow transition-all duration-200 hover:bg-lime-glow hover:shadow-none active:scale-95"
      >
        Deploy Snark
      </a>
    </nav>

    <!-- Mobile hamburger (48px touch target) -->
    <button
      id="menu-toggle"
      type="button"
      class="flex h-12 w-12 items-center justify-center rounded-xl border border-stroke bg-surface text-zinc-200 transition-colors duration-200 hover:border-lime hover:text-lime lg:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="14" y2="17"></line>
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-stroke bg-obsidian/95 px-4 pb-4 pt-2 backdrop-blur-md lg:hidden"
    aria-label="Mobile"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link flex min-h-12 items-center rounded-lg px-4 text-base font-medium text-zinc-200 transition-colors duration-200 hover:bg-surface hover:text-lime"
        >
          {link.label}
        </a>
      ))
    }
    <button
      type="button"
      class="sincerity-mode mobile-nav-link flex min-h-12 w-full items-center gap-2 rounded-lg px-4 text-base font-medium text-monogrey transition-colors duration-200 hover:bg-surface hover:text-snarkpink"
    >
      <span aria-hidden="true">🌷</span>
      Sincerity Mode™
    </button>
    <a
      href={`${base}#generator`}
      class="mobile-nav-link mt-2 flex min-h-12 items-center justify-center rounded-xl bg-lime px-5 text-base font-bold text-obsidian active:scale-95"
    >
      Deploy Snark
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function setMenu(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenu(!isOpen);
  });

  // Close the menu when a link is tapped — we're snarky, not user-hostile.
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  // ─── Sincerity Mode™ (beta): four seconds of unbearable warmth ───
  // Promoted from the footer fine print to the top bar, where it can do real damage.
  let sincerityActive = false;

  document.querySelectorAll('.sincerity-mode').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (sincerityActive) return;
      sincerityActive = true;

      const overlay = document.createElement('div');
      overlay.style.cssText =
        'position:fixed;inset:0;z-index:90;display:flex;align-items:center;justify-content:center;' +
        'background:rgba(15,15,17,0.55);backdrop-filter:blur(2px);opacity:0;transition:opacity .4s;' +
        'pointer-events:none;text-align:center;padding:24px;';
      overlay.innerHTML =
        '<p style="font-size:clamp(22px,4vw,40px);font-weight:900;color:#fff;max-width:640px;line-height:1.3;">' +
        'You are valued. You are enough. Everyone loves your replies. 🌷</p>';
      document.body.appendChild(overlay);

      const root = document.documentElement;
      root.style.transition = 'filter .6s';
      root.style.filter = 'invert(1) hue-rotate(180deg) saturate(1.3)';
      requestAnimationFrame(() => {
        overlay.style.opacity = '1';
      });

      window.setTimeout(() => {
        root.style.filter = '';
        overlay.style.opacity = '0';
        window.setTimeout(() => {
          overlay.remove();
          sincerityActive = false;
          const note = document.createElement('div');
          note.setAttribute('role', 'status');
          note.style.cssText =
            'position:fixed;bottom:96px;left:50%;transform:translateX(-50%);z-index:80;' +
            'background:#18181B;border:1px solid #F43F5E;color:#E4E4E7;padding:12px 20px;' +
            'border-radius:12px;font-family:ui-monospace,monospace;font-size:13px;' +
            'box-shadow:0 0 24px rgba(244,63,94,.25);transition:opacity .3s;pointer-events:none;';
          note.textContent = 'That was awful. Never again. — The Overseers';
          document.body.appendChild(note);
          window.setTimeout(() => {
            note.style.opacity = '0';
            window.setTimeout(() => note.remove(), 400);
          }, 2600);
        }, 450);
      }, 4000);
    });
  });
</script>
