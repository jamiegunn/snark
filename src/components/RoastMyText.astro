---
// Roast My Text™ — paste whatever a product just told you, receive the truth
// it was hiding. Runs entirely in your browser. Nothing leaves; nothing is logged.
---

<section id="roast" class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-3xl">
    <div class="mb-10 text-center" data-reveal>
      <p class="mb-2 font-mono text-xs uppercase tracking-widest text-lime">New · Interactive</p>
      <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
        Roast My Text<span class="text-snarkpink">™</span>
      </h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-monogrey sm:text-base">
        Paste a release note, a support reply, or anything an app has ever said to
        you. We'll translate it back into what it actually meant. Nothing is
        uploaded — for once.
      </p>
    </div>

    <div class="spotlight rounded-2xl border border-stroke bg-surface p-5 sm:p-8" data-reveal>
      <label class="block">
        <span class="mb-2 block text-sm font-semibold text-zinc-200">Exhibit A</span>
        <textarea
          id="roast-input"
          rows="6"
          placeholder="We're excited to announce a fresh new look! We've been listening to your feedback and are rolling out a streamlined, AI-powered experience to serve you better. Some features are temporarily unavailable. Thanks for your patience!!"
          class="w-full rounded-xl border border-stroke bg-obsidian px-4 py-3 text-base text-zinc-200 placeholder:text-zinc-600 transition-colors duration-200 focus:border-lime focus:outline-none focus:ring-1 focus:ring-lime"
        ></textarea>
      </label>

      <button
        id="roast-btn"
        type="button"
        class="mt-4 flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-snarkpink px-6 py-3 text-base font-bold text-white transition-all duration-200 hover:bg-rose-400 hover:shadow-pink-glow active:scale-95"
      >
        Translate to Truth
      </button>

      <!-- Results -->
      <div id="roast-results" class="mt-6 hidden">
        <div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-stroke bg-obsidian px-4 py-3">
          <span class="font-mono text-xs uppercase tracking-wider text-zinc-500">
            Weasel Density
          </span>
          <span id="roast-score" class="font-mono text-sm font-bold text-lime">0%</span>
        </div>
        <ul id="roast-findings" class="space-y-3"></ul>
        <p id="roast-verdict" class="mt-5 rounded-xl border border-lime/40 bg-lime/5 p-4 text-sm leading-relaxed text-zinc-300"></p>
      </div>
    </div>
  </div>
</section>

<script>
  // The phrasebook. Compiled from release notes, cookie banners, and error
  // messages that were written by a committee and approved by a lawyer.
  const PHRASEBOOK: Array<[RegExp, string, string]> = [
    [/performance improvements|bug fixes/i, 'Performance improvements and bug fixes', 'A button moved four pixels. Performance is identical. The bug you reported turns two next month.'],
    [/(updated|changes to) our (privacy )?(policy|terms)/i, 'We’ve updated our terms', 'They have. The change is on page nine, it is not in your favor, and you are going to click Agree.'],
    [/(fresh|bold)?\s*new look|redesign(ed)?/i, 'A fresh new look', 'Everything you knew how to find is now somewhere else, under a heading called More.'],
    [/(we(’|\')?(re|ve)|are) listening|your feedback/i, 'We’re listening to your feedback', 'They read it. They filed it. The folder has no owner and has never been opened twice.'],
    [/to serve you better|better serve/i, 'To serve you better', 'Whatever follows this phrase is worse for you. That is the function of the phrase.'],
    [/streamlin(e|ed|ing)/i, 'Streamlined', 'Features were removed. Calling it streamlining means nobody has to say which ones.'],
    [/ai[- ]powered|powered by ai|smart(er)? (assistant|suggestions)/i, 'AI-powered', 'Confidently wrong, but instantly, and in a pleasant font.'],
    [/seamless(ly)?/i, 'Seamless', 'There are seams. You will find them. They will be load-bearing.'],
    [/we take your privacy (very )?seriously/i, 'We take your privacy seriously', 'Announced immediately before a list of one thousand and eleven trusted partners.'],
    [/trusted partners?/i, 'Trusted partners', 'Trusted by them. Never introduced to you. There are more of them than there are of you.'],
    [/legitimate interest/i, 'Legitimate interest', 'A legal term meaning theirs. Reject All is at the bottom, in grey, and smaller on purpose.'],
    [/personali[sz]ed (experience|recommendations|ads)/i, 'Personalized experience', 'They have built a version of you out of receipts, and they like it more than you do.'],
    [/sunset(ting)?|deprecat(e|ed|ing)|end of life/i, 'Sunsetting', 'The thing you use every day is being killed, and they have found a word for it that sounds like a holiday.'],
    [/rolling out (gradually|to)|phased rollout|select users/i, 'Rolling out gradually', 'You are not in the first group. You are never in the first group. Nobody has ever met the first group.'],
    [/coming soon|later this year/i, 'Coming soon', 'Soon is not a unit of time. That is why they chose it.'],
    [/we(’|\')?re (so |very )?excited to announce/i, 'We’re excited to announce', 'Nobody is excited. Somewhere in that building, a person had to type this.'],
    [/known issue|working as intended|by design/i, 'Known issue / working as intended', 'It is broken and they have decided that is a design decision. You are now the one who is wrong.'],
    [/(have you )?tr(y|ied) (restarting|turning it off)/i, 'Have you tried restarting?', 'It will work. That is the humiliating part.'],
    [/unexpected error|something went wrong/i, 'Something went wrong', 'Something did. They know exactly what. There is a log. You will not be shown the log.'],
    [/(temporarily |currently )?unavailable|try again later/i, 'Temporarily unavailable', 'Temporary is doing the same job here that soon does elsewhere.'],
    [/your (call|business) is important to us/i, 'Your call is important to us', 'Important enough for a recording about it. Not important enough for a person.'],
    [/opt[- ]out at any time|unsubscribe at any time/i, 'Opt out at any time', 'At any time, in seven steps, ending with a page that asks whether you are sure.'],
    [/unlimited\*?/i, 'Unlimited', 'There is an asterisk. There is always an asterisk. The asterisk has its own asterisk.'],
    [/(public )?beta|early access/i, 'Beta', 'You are the testing budget. Thank you for volunteering, which you did by installing it.'],
    [/engagement|delight(ful)?/i, 'Engagement / delight', 'Words for what a person does, used to describe what a number does.'],
    [/ecosystem/i, 'Ecosystem', 'A fence, described lovingly, from the inside.'],
    [/thanks for your patience/i, 'Thanks for your patience', 'The patience is assumed and the thanks are pre-paid. You were not consulted on either.'],
    [/due to (unprecedented|high) demand/i, 'Due to unprecedented demand', 'Two servers. It has always been two servers.'],
  ];

  const input = document.getElementById('roast-input') as HTMLTextAreaElement | null;
  const btn = document.getElementById('roast-btn');
  const results = document.getElementById('roast-results');
  const findingsEl = document.getElementById('roast-findings');
  const scoreEl = document.getElementById('roast-score');
  const verdictEl = document.getElementById('roast-verdict');

  function verdictFor(score: number, exclamations: number, emoji: number): string {
    const notes: string[] = [];
    if (score === 0) {
      return 'Suspiciously plain. We found nothing. Either a human wrote this without supervision, or the weasels have gotten better. We are not sure which is worse.';
    }
    if (score >= 70) {
      notes.push('Diagnosis: fully shipped. This is not a message, it is a changelog wearing a smile. Nothing described here happened.');
    } else if (score >= 40) {
      notes.push('Diagnosis: written by committee, approved by legal, softened by marketing. Remove the jargon and you are left with "we changed something."');
    } else {
      notes.push('Diagnosis: mild exposure. A few phrases have escaped the release notes. Treatable, if caught before the next update.');
    }
    if (exclamations >= 3) {
      notes.push(`Also: ${exclamations} exclamation marks. That much enthusiasm is hiding something.`);
    }
    if (emoji > 0) {
      notes.push(`And ${emoji} emoji, deployed as human shields.`);
    }
    return notes.join(' ');
  }

  btn?.addEventListener('click', () => {
    if (!input || !results || !findingsEl || !scoreEl || !verdictEl) return;
    const text = input.value.trim();
    if (!text) {
      verdictEl.textContent = 'You pasted nothing. Bold — and still more informative than the last four update notes we read.';
      findingsEl.innerHTML = '';
      scoreEl.textContent = '0%';
      results.classList.remove('hidden');
      return;
    }

    const hits: Array<[string, string]> = [];
    for (const [pattern, label, roast] of PHRASEBOOK) {
      if (pattern.test(text)) hits.push([label, roast]);
    }
    const exclamations = (text.match(/!/g) || []).length;
    const emoji = (text.match(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/gu) || []).length;

    const wordCount = text.split(/\s+/).length;
    const score = Math.min(98, Math.round((hits.length / Math.max(3, wordCount / 14)) * 100) + (hits.length > 0 ? 15 : 0));

    findingsEl.innerHTML = '';
    hits.forEach(([label, roast], i) => {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-stroke bg-obsidian p-4 opacity-0 transition-opacity duration-500';
      li.innerHTML =
        `<p class="font-mono text-xs font-bold text-snarkpink">DETECTED: ${label}</p>` +
        `<p class="mt-1 text-sm leading-relaxed text-zinc-300"></p>`;
      (li.querySelector('p:last-child') as HTMLElement).textContent = roast;
      findingsEl.appendChild(li);
      window.setTimeout(() => li.classList.remove('opacity-0'), 120 * (i + 1));
    });

    scoreEl.textContent = `${score}%`;
    scoreEl.classList.toggle('text-snarkpink', score >= 50);
    scoreEl.classList.toggle('text-lime', score < 50);
    verdictEl.textContent = verdictFor(score, exclamations, emoji);
    results.classList.remove('hidden');
  });
</script>
