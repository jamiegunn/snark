---
import Logo from './Logo.astro';
---

<section id="top" class="relative overflow-hidden px-4 pb-16 pt-12 text-center sm:px-6 sm:pb-24 sm:pt-20">
  <!-- Decorative glow blobs -->
  <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full bg-lime/10 blur-3xl sm:h-96 sm:w-96" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-32 right-0 h-64 w-64 rounded-full bg-snarkpink/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-3xl flex-col items-center">
    <!-- Version badge -->
    <span
      class="mb-6 inline-flex min-h-10 items-center gap-2 rounded-full border border-stroke bg-surface px-4 py-2 font-mono text-xs text-monogrey animate-fade-up sm:text-sm"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-lime"></span>
      </span>
      Version 2.0: Now 40% More Passive-Aggressive
    </span>

    <!-- Big mascot moment -->
    <div class="mb-6 animate-fade-up" style="animation-delay: 0.05s;">
      <Logo class="h-20 w-20 sm:h-24 sm:w-24" />
    </div>

    <!-- Headline -->
    <h1
      class="text-balance text-4xl font-black leading-tight tracking-tight text-white animate-fade-up sm:text-5xl lg:text-6xl"
      style="animation-delay: 0.1s;"
    >
      Snark: Because Sincerity Was
      <span class="bg-gradient-to-r from-lime via-lime to-snarkpink bg-clip-text text-transparent"
        >Getting Exhausting</span
      ><span class="text-snarkpink">.</span>
    </h1>

    <!-- Subhead -->
    <p
      class="mt-5 max-w-xl text-balance text-base leading-relaxed text-monogrey animate-fade-up sm:text-lg"
      style="animation-delay: 0.2s;"
    >
      The world's first Sarcasm-as-a-Service platform. Cloud-hosted contempt, 99.9%
      uptime, and the reply you thought of forty minutes too late — this time on
      schedule. You seem lovely. We can fix that.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex w-full flex-col gap-3 animate-fade-up sm:w-auto sm:flex-row sm:gap-4" style="animation-delay: 0.3s;">
      <a
        href="#generator"
        class="flex min-h-12 w-full items-center justify-center rounded-xl bg-lime px-8 py-3 text-base font-bold text-obsidian shadow-lime-glow transition-all duration-200 hover:-translate-y-0.5 hover:bg-lime-glow active:translate-y-0 active:scale-95 sm:w-auto"
      >
        Generate Snark, Free Forever*
      </a>
      <a
        href="#manifesto"
        class="flex min-h-12 w-full items-center justify-center rounded-xl border border-stroke bg-surface px-8 py-3 text-base font-semibold text-zinc-200 transition-all duration-200 hover:border-snarkpink hover:text-snarkpink active:scale-95 sm:w-auto"
      >
        Read the Manifesto
      </a>
    </div>

    <p class="mt-4 font-mono text-[11px] text-zinc-500 animate-fade-up" style="animation-delay: 0.4s;">
      *Free until we invent a reason it isn't.
    </p>

    <!-- Fake trust bar -->
    <div class="mt-12 w-full animate-fade-up" style="animation-delay: 0.5s;">
      <p class="mb-4 font-mono text-[11px] uppercase tracking-widest text-zinc-500">
        Installed, then muted, by users of
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-sm font-semibold text-zinc-600 sm:gap-x-10">
        <span>Notifly</span>
        <span>Cloudn't</span>
        <span>Definitely.ai</span>
        <span>Bufferwheel</span>
        <span class="hidden sm:inline">AreYouStillWatching&nbsp;LLC</span>
      </div>
    </div>
  </div>
</section>
